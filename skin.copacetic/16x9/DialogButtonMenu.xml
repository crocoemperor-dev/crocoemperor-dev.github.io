<?xml version="1.0" encoding="UTF-8"?>
<window>
	<!-- shutdownmenu -->
	<defaultcontrol always="true">3001</defaultcontrol>
	<include content="WindowOpenClose_Fade_Delayed_Animation" />
	<zorder>3</zorder>
	<controls>
		<include content="Horizontal_List">
			<param name="hidden_id" value="3001" />
			<param name="focused_color" value="$VAR[Light_Color]" />
			<param name="unfocused_color" value="$VAR[Light_Color]" />
		</include>
		<include content="Time_Widget" condition="![Window.IsVisible(home) + Skin.HasSetting(Time_Widget_Persistent)] + !$EXP[Settings_Window_IsVisible]">
			<param name="visible" value="true" />
		</include>
		<control type="list" id="3001">
			<visible allowhiddenfocus="true">false</visible>
			<onup>Close</onup>
			<ondown>Close</ondown>
			<width>1680</width>
			<!-- pointing left/right at the list itself lets Kodi wrap between the first and last item -->
			<onleft>3001</onleft>
			<onright>3001</onright>
			<orientation>horizontal</orientation>
			<itemlayout width="100" />
			<focusedlayout width="100" />
			<content>
				<include content="shutdownmenu_Content" />
				<include content="skinshortcuts-shutdownmenu" />
			</content>
		</control>
	</controls>
</window>