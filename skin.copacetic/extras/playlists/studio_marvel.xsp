<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<smartplaylist type="movies">
    <name>Marvel Studios</name>
    <match>all</match>
    <rule field="studio" operator="contains">
        <value>Marvel Studios</value>
        <value>Marvel Entertainment</value>
        <value>Marvel Enterprises</value>
    </rule>
    <order direction="descending">year</order>
</smartplaylist>
